    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "semantic-release": "^24.2.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3"
  }
